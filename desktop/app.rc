// Resources for MyMind.exe: icon, manifest (embedded here; the linker runs with /MANIFEST:NO) and version info.
#include <windows.h>
#include "app_version.h"  // written by build.cmd: APP_VERSION "1.2.3" and APP_VERSION_NUM 1,2,3,0

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Sava Vladut"
      VALUE "FileDescription", "My Mind"
      VALUE "FileVersion", APP_VERSION
      VALUE "InternalName", "MyMind"
      VALUE "OriginalFilename", "MyMind.exe"
      VALUE "ProductName", "My Mind"
      VALUE "ProductVersion", APP_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
