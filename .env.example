# Copy to .env and fill in. Everything is optional — without Pinterest or Spotify keys
# the app still works, and pasting a Pinterest pin link or a Spotify song link still attaches it.

PORT=8085
# Public address of this server (used for the Pinterest and Spotify OAuth redirects).
PUBLIC_URL=http://localhost:8085

# From https://developers.pinterest.com/apps/ → your app → Manage.
# Add this redirect URI to the app:  <PUBLIC_URL>/api/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# From https://developer.spotify.com/dashboard → Create app (tick "Web API") → Settings.
# Add this redirect URI to the app:  http://127.0.0.1:8085/api/spotify/callback
# (Spotify refuses "localhost" — use 127.0.0.1 even if you open the app at localhost.)
# While the app is in development mode, add your Spotify account under User Management.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only needed if the server is reachable elsewhere; must be https or a 127.0.0.1 address.
# SPOTIFY_REDIRECT_URI=https://mind.example.com/api/spotify/callback

# Encrypts the login cookies. If empty, one is generated into data/.secret
SESSION_SECRET=
